{"chunk_id": "add59d62594b4fff5536b6b1feb49c7e78ec04a6", "repo_full_name": "Eastonjamee/realtime-collaborative-whiteboard", "commit_sha": "", "path": "client/src/App.js", "chunk_role": "entrypoint", "language": "JavaScript", "symbol": "canvasRef", "heading": null, "start_line": 7, "end_line": 9, "token_count": 13, "repo_score": 0.3758, "content_hash": "2bd01daa8b47d90c6ecce74b4035a496e8bb92ac", "text": "const canvasRef = useRef(null);\n\n  useEffect(() => {"}
{"chunk_id": "3d0cfc61ca831d59bfa19f010afcd69d85fc6bf5", "repo_full_name": "Eastonjamee/realtime-collaborative-whiteboard", "commit_sha": "", "path": "client/src/App.js", "chunk_role": "entrypoint", "language": "JavaScript", "symbol": "canvas", "heading": null, "start_line": 10, "end_line": 10, "token_count": 8, "repo_score": 0.3758, "content_hash": "94a64038bbf936440df0bf8d64c174b85a9f3779", "text": "const canvas = canvasRef.current;"}
{"chunk_id": "1d34a4ec02c293a125818092bbf03081d610ff42", "repo_full_name": "Eastonjamee/realtime-collaborative-whiteboard", "commit_sha": "", "path": "client/src/App.js", "chunk_role": "entrypoint", "language": "JavaScript", "symbol": "ctx", "heading": null, "start_line": 11, "end_line": 16, "token_count": 52, "repo_score": 0.3758, "content_hash": "5c84d2499963f2f5a93403a33ecc9d351762de79", "text": "const ctx = canvas.getContext('2d');\n\n    socket.on('draw', drawLine);\n    socket.on('clear', () => ctx.clearRect(0, 0, canvas.width, canvas.height));\n    socket.on('init', (lines) => lines.forEach(drawLine));"}
{"chunk_id": "fbfe5a39bad4b9d1a55e76cf65bf1ecdd9f7ed55", "repo_full_name": "Eastonjamee/realtime-collaborative-whiteboard", "commit_sha": "", "path": "client/src/App.js", "chunk_role": "entrypoint", "language": "JavaScript", "symbol": "drawLine", "heading": null, "start_line": 17, "end_line": 25, "token_count": 41, "repo_score": 0.3758, "content_hash": "c2ac9b8ac8fee2e93ffdc89e0e579c90e3d82878", "text": "function drawLine({ x0, y0, x1, y1 }) {\n      ctx.beginPath();\n      ctx.moveTo(x0, y0);\n      ctx.lineTo(x1, y1);\n      ctx.stroke();\n    }\n\n    let drawing = false;"}
{"chunk_id": "576e9d4bd71054cc20a2e654d2788132859efff2", "repo_full_name": "Eastonjamee/realtime-collaborative-whiteboard", "commit_sha": "", "path": "client/src/App.js", "chunk_role": "entrypoint", "language": "JavaScript", "symbol": "startDraw", "heading": null, "start_line": 26, "end_line": 30, "token_count": 31, "repo_score": 0.3758, "content_hash": "42fb1830b468a5acba8bc8b8c49671706324a00b", "text": "const startDraw = (e) => {\n      drawing = true;\n      [lastX, lastY] = [e.nativeEvent.offsetX, e.nativeEvent.offsetY];\n    };"}
{"chunk_id": "b5422453824d3c7cb7bb967f7095f6ba07bde896", "repo_full_name": "Eastonjamee/realtime-collaborative-whiteboard", "commit_sha": "", "path": "client/src/App.js", "chunk_role": "entrypoint", "language": "JavaScript", "symbol": "endDraw", "heading": null, "start_line": 31, "end_line": 34, "token_count": 15, "repo_score": 0.3758, "content_hash": "eeff069dbcc9b17044337ee928cfca3c3bb95a2b", "text": "const endDraw = () => drawing = false;\n\n    let lastX, lastY;"}
{"chunk_id": "5e31cb19e8f83ca65b4abff3d11167c896fda0be", "repo_full_name": "Eastonjamee/realtime-collaborative-whiteboard", "commit_sha": "", "path": "client/src/App.js", "chunk_role": "entrypoint", "language": "JavaScript", "symbol": "draw", "heading": null, "start_line": 35, "end_line": 62, "token_count": 192, "repo_score": 0.3758, "content_hash": "4973137c4567c6bb80ca1b55952bfe581b6bd14f", "text": "const draw = (e) => {\n      if (!drawing) return;\n      const [x, y] = [e.nativeEvent.offsetX, e.nativeEvent.offsetY];\n      socket.emit('draw', { x0: lastX, y0: lastY, x1: x, y1: y });\n      drawLine({ x0: lastX, y0: lastY, x1: x, y1: y });\n      [lastX, lastY] = [x, y];\n    };\n\n    canvas.addEventListener('mousedown', startDraw);\n    canvas.addEventListener('mouseup', endDraw);\n    canvas.addEventListener('mousemove', draw);\n\n    return () => {\n      socket.off('draw');\n      socket.off('clear');\n      socket.off('init');\n    };\n  }, []);\n\n  return (\n    <div>\n      <canvas ref={canvasRef} width={800} height={600} style={{ border: '1px solid black' }} />\n      <button onClick={() => socket.emit('clear')}>Clear</button>\n    </div>\n  );\n}\n\nexport default App;"}
