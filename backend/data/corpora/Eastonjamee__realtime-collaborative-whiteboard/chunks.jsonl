{"chunk_id": "ffba1d7b56c2e1ddfb8e1f9365e2bfe622dbb83f", "repo_full_name": "Eastonjamee/realtime-collaborative-whiteboard", "commit_sha": "", "path": "server.js", "chunk_role": "source", "language": "JavaScript", "symbol": "server", "heading": null, "start_line": 7, "end_line": 7, "token_count": 9, "repo_score": 0.3758, "content_hash": "3a59c3655333be97344c3377b5b101bfce60324f", "text": "const server = http.createServer(app);"}
{"chunk_id": "2ddef1e7ef52af68a34a8a6a43543b25222a31bf", "repo_full_name": "Eastonjamee/realtime-collaborative-whiteboard", "commit_sha": "", "path": "server.js", "chunk_role": "source", "language": "JavaScript", "symbol": "io", "heading": null, "start_line": 8, "end_line": 32, "token_count": 118, "repo_score": 0.3758, "content_hash": "72cccfe52e7b97aad1920ff6dbe8617609d02d5d", "text": "const io = new Server(server);\n\nlet canvasState = [];\n\nio.on('connection', (socket) => {\n  console.log('A user connected');\n\n  socket.emit('init', canvasState);\n\n  socket.on('draw', (data) => {\n    canvasState.push(data);\n    socket.broadcast.emit('draw', data);\n  });\n\n  socket.on('clear', () => {\n    canvasState = [];\n    io.emit('clear');\n  });\n});\n\napp.use(express.static('client/build'));\n\nserver.listen(3000, () => {\n  console.log('Server listening on *:3000');\n});"}
{"chunk_id": "89c0750f6c259e4c1ce89328e37f201fe7633db5", "repo_full_name": "Eastonjamee/realtime-collaborative-whiteboard", "commit_sha": "", "path": "client/src/App.js", "chunk_role": "entrypoint", "language": "JavaScript", "symbol": "module_preamble", "heading": null, "start_line": 1, "end_line": 3, "token_count": 22, "repo_score": 0.3758, "content_hash": "c73171cbf50cc9822935ddf3b4d817bf6d3b0364", "text": "import React, { useRef, useEffect } from 'react';\nimport { io } from 'socket.io-client';"}
